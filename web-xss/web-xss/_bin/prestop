#!/bin/bash
outpath=/home/ubuntu/.local/result
mkdir -p "$outpath"
if [ -f "/home/ubuntu/report_zap.html" ] || [ -f "/home/ubuntu/report_zap" ] || [ -f "/home/ubuntu/Desktop/report_zap.html" ] || [ -f "/home/ubuntu/Desktop/report_zap" ]; then
   echo "zap_report_created" > "$outpath/zap_report.txt"
else
   echo "zap_report_missing" > "$outpath/zap_report.txt"
fi

# OWASP ZAP stores bulky session data, browser drivers, logs and caches under
# ~/.ZAP.  Those runtime files are not used by grading and can make the final
# Labtainer .lab artifact tens of MB larger after a normal ZAP scan.  Keep the
# exported report_zap.html above, but remove the transient ZAP state before
# Labtainer zips the student home directory.
rm -rf /home/ubuntu/.ZAP
