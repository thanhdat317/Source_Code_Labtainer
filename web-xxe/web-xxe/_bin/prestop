#!/bin/bash

# OWASP ZAP stores bulky session data, browser drivers, logs and caches under
# ~/.ZAP.  The grader only needs the exported report artifacts and other
# challenge evidence, not ZAP's transient runtime state.  Remove it before
# Labtainer zips the student home directory so checkwork/stoplab output stays
# small after students run a real ZAP scan.
rm -rf /home/ubuntu/.ZAP

exit 0
